rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper function to verify user ownership.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // === USER-SPECIFIC COLLECTIONS ===

    // Documents are top-level, identified by a unique ID, and contain a `uid` field.
    match /journals/{journalId} {
      allow read, update, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
    }
    match /moods/{moodId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
    }
    match /wellnessMemory/{memoryId} {
      allow read, update, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
    }
    match /chatHistory/{chatId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
    }

    // Documents are top-level, and the document ID is the user's UID.
    match /achievements/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /garden/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /examMode/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // User-specific data nested under a /users/{userId} document.
    match /users/{userId}/{documents=**} {
      allow read, write: if isOwner(userId);
    }

    // === PUBLIC & SHARED DATA ===

    match /senior_buddies/{buddyId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins should write
    }
  }
}
